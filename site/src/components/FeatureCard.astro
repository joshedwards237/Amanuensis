---
interface Props { icon: string; title: string; body: string; tone?: 'iris' | 'accent' | 'lime' }
const { icon, title, body, tone = 'iris' } = Astro.props
---
<div class="card">
  <span class={`ic ic-${tone}`} aria-hidden="true">{icon}</span>
  <h3 class="t-h3">{title}</h3>
  <p class="t-caption" set:html={body} />
</div>
<style>
  .card {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--s3);
    background: var(--panel);
    transition: border-color var(--t-hover) var(--ease);
  }
  .card:hover { border-color: var(--rule-strong); }
  .ic {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .ic-iris { background: var(--iris-soft); color: var(--iris); }
  .ic-accent { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
  .ic-lime { background: color-mix(in srgb, var(--lime) 14%, transparent); color: var(--lime); }
  .card h3 { margin-bottom: 0.35rem; }
  .card p { margin: 0; }
</style>
