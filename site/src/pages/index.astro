---
import Base from '../layouts/Base.astro'
import FeatureCard from '../components/FeatureCard.astro'
import claims from '../data/claims.json'
import session from '../data/sessions/hero-demo.json'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const gh = 'https://github.com/joshedwards237/Amanuensis'
const head = (claims.bands as Record<string, any>)[claims.headline_band]
---

<Base current="home">
  <!-- Hero -->
  <section class="hero">
    <div class="page hero-inner">
      <p class="eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Local dictation for macOS · open source
      </p>

      <h1 class="t-display">
        Speak. It's <em>already</em> text.
      </h1>

      <p class="t-lede hero-lede">
        Hold a key, talk, let go. Your words land at the cursor in whatever app you're
        in — transcribed on your own machine, in about a fifth of a second.
      </p>

      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}/docs`}>Install Amanuensis →</a>
        <a class="btn btn-ghost" href={`${base}/how-it-works`}>See how it works</a>
      </div>

      <p class="hero-meta t-caption">
        No account. No network at runtime. No audio leaving the device.
      </p>

      <!-- The one live artefact in the hero: a real row, not a mockup. -->
      <div class="proof">
        <div class="proof-row">
          <span class="t-label">You said</span>
          <p class="said">“{session.transcript}”</p>
        </div>
        {/* Three genuinely different facts. An earlier version showed this
            session's g1 next to the band p50, which in the current fixture are
            the same number — two slots spent saying one thing, and it read as
            a bug. The p95 is the more useful of the pair anyway: it is the one
            a sceptic asks for. */}
        <div class="proof-row proof-nums">
          <div>
            <span class="t-label">Typical ({head.label})</span>
            <p class="big">{head.p50_ms}<small>ms</small></p>
          </div>
          <div>
            <span class="t-label">Worst of {head.n}</span>
            <p class="big">{head.p95_ms}<small>ms</small></p>
          </div>
          <div>
            <span class="t-label">Left your machine</span>
            <p class="big lime">0<small>bytes</small></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="page">
      <h2 class="t-h2">Built for people who talk faster than they type.</h2>
      <div class="grid">
        <FeatureCard
          icon="⌥"
          title="One key, any app"
          body="Hold right-option anywhere — editor, terminal, browser, chat. The text arrives at your cursor. There's no window to switch to and nothing to paste."
        />
        <FeatureCard
          icon="●"
          tone="accent"
          title="You always know when it's listening"
          body="A menu-bar glyph shows idle, recording, or transcribing. The mic state is never ambiguous — that's a privacy requirement, not a nicety."
        />
        <FeatureCard
          icon="↓"
          tone="lime"
          title="Your words are saved first"
          body="The transcript is written to disk <em>before</em> it's pasted. A crash or a failed paste can't cost you what you said."
        />
        <FeatureCard
          icon="⚠"
          tone="accent"
          title="It refuses to guess"
          body="If the decoder mangles your speech, the text is withheld rather than injected — and <code>manu history --last</code> still has it."
        />
        <FeatureCard
          icon="✎"
          title="Cleaned up as it lands"
          body="A deterministic pass fixes whitespace, capitalisation and punctuation spacing. It costs under a millisecond and never rewrites your words."
        />
        <FeatureCard
          icon="{ }"
          title="Yours to change"
          body="Every decision that could go either way is a key in a config file. Custom vocabulary, hotkey, injection strategy, retention."
        />
      </div>
    </div>
  </section>

  <!-- Privacy band -->
  <section class="band">
    <div class="page band-inner">
      <div>
        <h2 class="t-h2">The whole thing runs on your laptop.</h2>
        <p class="t-lede">
          Not "encrypted in transit". Not "we don't train on your data". The audio never
          reaches a network interface, and that's been checked with a packet capture rather
          than asserted in a privacy policy.
        </p>
        <p>
          <a href={`${base}/how-it-works#network`}>See the measurement →</a>
        </p>
      </div>
      <div class="band-stat">
        <p class="big lime">0</p>
        <p class="t-label">sockets opened</p>
        <p class="big lime">0</p>
        <p class="t-label">bytes sent</p>
        <p class="t-caption band-note">
          Against a control that saw 865 bytes — because an instrument that can't see traffic
          proves nothing by reporting none.
        </p>
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="close">
    <div class="page">
      <h2 class="t-h2">Try it in about two minutes.</h2>
      <pre><code>pip install -e .
manu install
manu daemon</code></pre>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}/docs`}>Read the install guide →</a>
        <a class="btn btn-ghost" href={gh}>Star on GitHub</a>
      </div>
      <p class="t-caption">
        macOS, Python 3.12+. Runs from a source checkout — there's no packaged app yet, and
        the <a href={`${base}/how-it-works#unmeasured`}>things that aren't measured</a> are
        listed rather than hidden.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: var(--s6) 0 var(--s5); }
  .hero-inner { max-width: 60rem; }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    margin: 0 0 var(--s3);
  }
  .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
  }
  .hero-lede { max-width: 34rem; margin: var(--s3) 0 var(--s4); }
  .hero-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .hero-meta { margin-top: var(--s2); color: var(--muted); }

  .proof {
    margin-top: var(--s5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }
  .proof-row { padding: var(--s3); }
  .proof-row + .proof-row { border-top: 1px solid var(--rule); }
  .said {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.3;
    margin: 0.4rem 0 0;
  }
  .proof-nums {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s3);
    background: var(--bg-alt);
  }
  .big {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 500;
    margin: 0.2rem 0 0;
    letter-spacing: -0.02em;
  }
  .big small { font-size: 0.85rem; color: var(--muted); margin-left: 0.3rem; font-weight: 400; }
  .big.lime { color: var(--lime); }

  .features { padding: var(--s6) 0; }
  .features h2 { max-width: 24ch; margin-bottom: var(--s4); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--s2);
  }

  .band { background: var(--bg-alt); padding: var(--s6) 0; border-block: 1px solid var(--rule); }
  .band-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s5);
    align-items: start;
  }
  .band-inner h2 { margin-bottom: var(--s2); }
  .band-stat .big { font-size: 3rem; line-height: 1; }
  .band-stat .t-label { display: block; margin-bottom: var(--s2); }
  .band-note { margin-top: var(--s2); }

  .close { padding: var(--s6) 0; }
  .close h2 { margin-bottom: var(--s3); }
  .close pre { max-width: 26rem; margin-bottom: var(--s3); }

  @media (max-width: 780px) {
    .proof-nums { grid-template-columns: 1fr; }
    .band-inner { grid-template-columns: 1fr; gap: var(--s4); }
  }
</style>
