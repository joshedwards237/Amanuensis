---
/**
 * The shell every page shares: nav, skip link, footer.
 *
 * The nav is the only navigation on the site and it names four things. That is
 * deliberate — a product with one loop does not need a mega-menu, and every
 * additional destination is a page somebody has to keep true.
 */
interface Props {
  title?: string
  description?: string
  /** Which nav item to mark as current. */
  current?: 'home' | 'how' | 'docs'
}

const {
  title = 'Amanuensis — local dictation for macOS',
  description = 'Hold a key, speak, release. Your words appear at the cursor. Runs entirely on your machine — no account, no network at runtime, no audio leaving the device.',
  current,
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const gh = 'https://github.com/joshedwards237/Amanuensis'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {/* No preconnect, no external stylesheet, no font host. The absence is the
        product claim; scripts/verify_site_network.py fails the build on any
        origin that is not our own. */}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <nav class="nav" aria-label="Primary">
      <div class="nav-inner">
        <a class="nav-brand" href={`${base}/`}>Amanuensis</a>
        <div class="nav-links">
          <a href={`${base}/how-it-works`} aria-current={current === 'how' ? 'page' : undefined}>
            How it works
          </a>
          <a href={`${base}/docs`} aria-current={current === 'docs' ? 'page' : undefined}>
            Docs
          </a>
          <a href={gh}>GitHub</a>
          <a class="btn btn-primary nav-cta" href={`${base}/docs`}>Install</a>
        </div>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="page">
        <p>
          <strong style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 400;"
            >Amanuensis</strong
          ><br />
          <em>amanuensis</em>, from Latin <em>servus a manu</em> — one employed to take down the
          words of another.
        </p>
        <p>
          <a href={`${base}/how-it-works`}>How it works</a> ·
          <a href={`${base}/docs`}>Docs</a> ·
          <a href={gh}>Source</a> ·
          <a href={`${gh}/blob/main/AMANUENSIS_PRD.md`}>Specification</a> ·
          <a href={`${gh}/tree/main/docs/gates`}>Gate records</a>
        </p>
        <p>
          Apache-2.0. macOS only. Runs from a source checkout — there is no packaged app yet.
        </p>
        <p>
          The mature alternatives are <a href="https://github.com/ideasman42/nerd-dictation"
            >nerd-dictation</a
          > on Linux and <a href="https://talonvoice.com">Talon</a>. The specification records why
          this exists alongside them.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/base.css';
</style>
